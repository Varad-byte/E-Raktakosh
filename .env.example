# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Embedded SQLite - Zero Setup)
DB_PATH=./data/bbims.db

# Authentication / Security
JWT_SECRET=bbims_clinical_vault_jwt_secret_key_2026_prod
